{
  "name": "protohax-userscript-template",
  "version": "0.2.0",
  "private": true,
  "description": "Template for writing ProtoHax client modules in TypeScript.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "dev": "node build.mjs --watch --deploy",
    "deploy": "node build.mjs --deploy",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@protohax/userscript": "^0.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-swc": "^0.4.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@swc/core": "^1.15.46",
    "rollup": "^4.62.2",
    "typescript": "^6.0.3"
  }
}
